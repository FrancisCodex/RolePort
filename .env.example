# Local single-user mode: no sign-in, everything belongs to one built-in user.
HIREME_LOCAL_MODE=true

# Database. Leave unset to use the built-in embedded database in .data/pglite.
# Set it to use a Postgres server (local, Supabase, Neon), then run: npm run db:migrate
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/hireme

# Better Auth (only used when HIREME_LOCAL_MODE is not "true").
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Claude (profile extraction, match scoring, CV/cover letter). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: JSearch via RapidAPI (Google for Jobs listings across the Philippines).
# https://rapidapi.com/letscrunch/api/jsearch
RAPIDAPI_KEY=
