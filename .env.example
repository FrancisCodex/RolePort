# Local single-user mode: no sign-in, everything belongs to one built-in user.
HIREME_LOCAL_MODE=true

# Database. Leave unset to use the built-in embedded database in .data/pglite.
# Set it to use a Postgres server (local, Supabase, Neon), then run: npm run db:migrate
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/hireme

# Encrypts API keys saved in Settings. If unset, a random key is generated in .data/secret.key.
# Set it explicitly when hosting, and keep it stable (changing it makes saved keys unreadable).
# HIREME_SECRET=

# ---------------------------------------------------------------------------
# AI provider. Easiest: choose it in the app under Settings. These are fallbacks.
# ---------------------------------------------------------------------------
# Claude:
# ANTHROPIC_API_KEY=
# Or any OpenAI-compatible server (Ollama, LM Studio, OpenAI, OpenRouter, Groq):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# AI_MODEL=gemma4:12b
# AI_REASONING_EFFORT=none

# Optional: JSearch via RapidAPI (Google for Jobs listings). Also settable in Settings.
# RAPIDAPI_KEY=

# Optional, self-hosted only: the JobSpy service for LinkedIn, Indeed, Glassdoor, Bayt, Naukri…
# Start it with `npm run jobspy` (Docker) or `python services/jobspy/server.py`, then turn it on in Settings.
# (A full `docker compose up` runs it for you.)
# JOBSPY_URL=http://127.0.0.1:8765

# Optional: start new users on the welcome guide (/welcome) instead of Home.
# On by default in HireMe Lite, off for self-hosted installs. The guide stays reachable from Home either way.
# NEXT_PUBLIC_HIREME_ONBOARDING=on

# ---------------------------------------------------------------------------
# Accounts (only when HIREME_LOCAL_MODE is not "true")
# ---------------------------------------------------------------------------
# BETTER_AUTH_SECRET=   # npx @better-auth/cli secret
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
