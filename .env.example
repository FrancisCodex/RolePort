# Postgres connection string (local Postgres, Neon, or Supabase)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/hireme

# Better Auth — generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
