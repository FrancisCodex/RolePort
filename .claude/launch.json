{
  "version": "0.0.1",
  "configurations": [
    { "name": "roleport-dev", "runtimeExecutable": "npm", "runtimeArgs": ["run", "dev"], "port": 3000 },
    {
      "name": "roleport-test",
      "runtimeExecutable": "powershell",
