{
  "name": "roleport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "next build",
    "start": "next start",
    "dev:lite": "node scripts/lite.mjs dev --port 3100",
    "build:lite": "node scripts/lite.mjs build",
    "start:lite": "node scripts/lite.mjs start --port 3100",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "db:check-bundle": "node scripts/bundle-migrations.mjs --check",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "jobspy": "docker compose up -d --build jobspy",
    "jobspy:stop": "docker compose stop jobspy",
    "jobspy:logs": "docker compose logs -f jobspy",
    "docs:sources": "node scripts/sources-table.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@huggingface/transformers": "^4.3.2",
    "@react-pdf/renderer": "^4.9.0",
    "asciify-engine": "4.32.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
